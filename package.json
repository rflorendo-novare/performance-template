{
  "name": "performance-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "k6:local:stg:product-service": "k6 run environments/stg/dummyJson/tests/products-service/load.ts",
    "k6:local:stg:login-service": "k6 run environments/stg/dummyJson/tests/login-service/load.ts",
    "k6:cloud:stg:product-service": "k6 run environments/stg/dummyJson/tests/products-service/load.ts",
    "k6:local:stg:all": "npx tsx scripts/run-all.ts",
    "k6:cloud:stg:all": "npx tsx scripts/run-all.ts --cloud",
    "terraform:init": "terraform -chdir=terraform init",
    "terraform:fmt": "terraform -chdir=terraform fmt",
    "terraform:validate": "terraform -chdir=terraform validate",
    "terraform:plan": "terraform -chdir=terraform plan",
    "terraform:apply": "terraform -chdir=terraform apply",
    "terraform:destroy": "terraform -chdir=terraform destroy",
    "check": "tsc && dprint check",
    "format": "dprint fmt",
    "prepack": "lefthook install"
  },
  "devDependencies": {
    "@types/k6": "^2.0.0",
    "dprint": "^0.55.1",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
